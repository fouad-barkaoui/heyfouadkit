# Copy this file to .env (git-ignored) for local development.
# On Vercel, set the same two names under Project Settings > Environment Variables.
# Leave both empty to run fully offline against localStorage (demo mode).
# These are Supabase *publishable* values; never put a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
